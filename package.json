{
  "name": "funds",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @funds/web dev",
    "build": "pnpm --filter @funds/core build && pnpm --filter @funds/web build && pnpm --filter @funds/extension build",
    "build:web": "pnpm --filter @funds/core build && pnpm --filter @funds/web build",
    "build:extension": "pnpm --filter @funds/extension build",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
