{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["chrome"],
    "baseUrl": ".",
    "paths": {
      "@funds/core/csv": ["../../packages/core/src/csv.ts"],
      "@funds/core/excel": ["../../packages/core/src/excel.ts"],
      "@funds/core/types": ["../../packages/core/src/types.ts"],
      "@funds/banks": ["../../packages/banks/src/index.ts"]
    }
  },
  "include": ["src"]
}
